{
  "name": "@wcg-hieule/notebooklm-mcp",
  "version": "1.0.0",
  "description": "NotebookLM MCP Server — TypeScript implementation with 32 tools for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "notebooklm-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "notebooklm",
    "google",
    "ai",
    "model-context-protocol",
    "typescript"
